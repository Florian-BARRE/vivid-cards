# Copy this file to .env.local and point it at your Home Assistant www folder.
# `npm run deploy` builds the bundle and copies it there.
# Examples:
#   Samba share on Windows:  VIVID_DEPLOY_DIR=\\homeassistant\config\www\vivid-cards
#   Mounted share on Linux:  VIVID_DEPLOY_DIR=/mnt/ha-config/www/vivid-cards
VIVID_DEPLOY_DIR=
